# Giscus configuration (https://giscus.app)
# Repo name in the format "owner/repo" (must be public).
NEXT_PUBLIC_GISCUS_REPO=thetroll791-eng/portofolio

# Repository ID (from giscus.app setup).
NEXT_PUBLIC_GISCUS_REPO_ID=

# Discussion category (usually "Announcements").
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements

# Discussion category ID (from giscus.app setup).
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
